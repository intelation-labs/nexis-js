{
	"name": "@intelation/nexis-mcp",
	"version": "0.1.0",
	"description": "MCP server that lets Claude, Cursor and other AI assistants find and remove personal data (PII) from text. Regulation-aware (GDPR, UK GDPR, HIPAA). Powered by Intelation Nexis.",
	"license": "MIT",
	"homepage": "https://www.intelation.com/integrations/javascript",
	"repository": { "type": "git", "url": "git+https://github.com/intelation-labs/nexis-js.git", "directory": "nexis-mcp" },
	"bugs": "https://github.com/intelation-labs/nexis-js/issues",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"nexis",
		"intelation",
		"pii",
		"redact",
		"privacy",
		"gdpr",
		"hipaa",
		"anonymization",
		"llm"
	],
	"author": { "name": "Intelation", "email": "integrations@intelation.com" },
	"type": "module",
	"main": "./dist/index.js",
	"bin": { "nexis-mcp": "dist/index.js" },
	"files": ["dist", "!dist/**/*.map"],
	"engines": { "node": ">=18" },
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "tsc -p tsconfig.test.json && node --test \".test-build/test/**/*.test.js\"",
		"prepublishOnly": "npm run build && npm test"
	},
	"dependencies": {
		"@intelation/nexis": "^0.1.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "5.9.3"
	},
	"publishConfig": { "access": "public" }
}
